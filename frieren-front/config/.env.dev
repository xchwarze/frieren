# api gateway
VITE_RELATIVE_API_PATH=api/index.php
VITE_DEV_PROXY_TARGET=http://localhost:8000

# device itself, for static assets the dev proxy forwards directly
# (e.g. third-party module UMD bundles) instead of through api-proxy.php
VITE_DEV_DEVICE_TARGET=http://192.168.7.1:5000

# name of the module folder in server
VITE_WEB_MODULES_FOLDER=modules

# for build
VITE_COMPRESSION_ENABLE=true
VITE_ANALYZER_ENABLE=false
VITE_SOURCEMAP_ENABLE=false
VITE_MANUAL_CHUNKS_ENABLE=true

# for release
VITE_BUILD_ID=dev
